<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NexMote Agent"
           Manufacturer="NexMote Inc."
           Version="0.5.1"
           UpgradeCode="A76F12C0-94A1-420E-B6D7-90E0F3628101"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="NexMote Agent uygulamasÄ±nÄ±n daha yeni bir sÃ¼rÃ¼mÃ¼ zaten kurulu." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="NexMoteFolder" Name="NexMote">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AgentDesktopShortcutComp" Guid="A9812A4F-821B-4190-84E1-912A09B2E801">
        <Shortcut Id="AgentDesktopShortcut"
                  Name="NexMote Agent"
                  Description="NexMote AjanÄ± MasaÃ¼stÃ¼ Ä°stemcisi"
                  Target="[INSTALLFOLDER]NexMote.Agent.Tray.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\NexMote\Agent" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="AgentServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentServiceExeComponent">
        <File Id="AgentServiceExe" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\NexMote.Agent.Windows.exe" KeyPath="yes" />
        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="NexMote Agent"
                        DisplayName="NexMote Agent Service"
                        Description="NexMote Kurumsal Uzaktan YÃ¶netim AjanÄ± Servisi"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal" />
        <ServiceControl Id="ServiceControler"
                        Name="NexMote Agent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="AgentTrayExeComponent">
        <File Id="AgentTrayExe" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\NexMote.Agent.Tray.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="NexMote Agent Tray"
                       Value="&quot;[INSTALLFOLDER]NexMote.Agent.Tray.exe&quot;"
                       Type="string" />
      </Component>

      <Component Id="CompFile_1"><File Id="File_1" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\appsettings.json" KeyPath="yes" /></Component>
      <Component Id="CompFile_2"><File Id="File_2" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\install-agent.ps1" KeyPath="yes" /></Component>
      <Component Id="CompFile_3"><File Id="File_3" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\install.bat" KeyPath="yes" /></Component>
      <Component Id="CompFile_4"><File Id="File_4" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\NexMote.Agent.Tray.pdb" KeyPath="yes" /></Component>
      <Component Id="CompFile_5"><File Id="File_5" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\NexMote.Agent.Windows.pdb" KeyPath="yes" /></Component>
      <Component Id="CompFile_6"><File Id="File_6" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\NexMote.Shared.pdb" KeyPath="yes" /></Component>
      <Component Id="CompFile_7"><File Id="File_7" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\README.txt" KeyPath="yes" /></Component>
      <Component Id="CompFile_8"><File Id="File_8" Source="C:\Users\ufuk.kaya\Desktop\Projeler\NexMote\artifacts\package\agent\uninstall-agent.ps1" KeyPath="yes" /></Component>

    </ComponentGroup>

    <CustomAction Id="LaunchTrayApp"
                  FileRef="AgentTrayExe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchTrayApp" After="InstallFinalize" Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="NexMote Agent" Level="1">
      <ComponentGroupRef Id="AgentServiceComponents" />
      <ComponentRef Id="AgentDesktopShortcutComp" />
    </Feature>
  </Package>
</Wix>
