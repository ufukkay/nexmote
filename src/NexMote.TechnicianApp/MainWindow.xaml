<Window x:Class="NexMote.TechnicianApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMote - Teknisyen Konsolu" Height="820" Width="1360"
        MinHeight="600" MinWidth="900"
        WindowState="Maximized"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <!-- Light SaaS button, matches the web console's palette (blue accent, white/slate surfaces) -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Floating Island Toolbar Buttons (Dark Glassmorphism matching Image 2 & Audit) -->
        <Style x:Key="IslandBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="islandBtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="islandBtnBorder" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandDangerBtn" TargetType="Button" BasedOn="{StaticResource IslandBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShellTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopHeaderRow" Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomStatusRow" Height="32" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar (SaaS style, visible during Device Inventory list) -->
        <Border x:Name="TopHeaderBorder" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <DockPanel LastChildFill="True">
                <!-- Right Info Pills -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeaderServerUrlText" Text="https://nexmote.com" Foreground="#047857" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="HeaderUserText" Text="Yönetici" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NexMote" Foreground="#0F172A" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Teknisyen konsolu" Foreground="#64748B" FontSize="12" Margin="8,2,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionText" Foreground="#94A3B8" FontSize="11" Text="Oturum bekleniyor..." Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area (Device Inventory or Remote Canvas) -->
        <Grid Grid.Row="1" Background="#F8FAFC">

            <!-- VIEW 1: Device Inventory Screen (Shown by default when app opens) -->
            <Grid x:Name="DeviceInventoryGrid" Visibility="Visible" Margin="24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ROW 0: KPI Summary Metric Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Toplam Cihaz -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,8,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOPLAM CİHAZ" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TotalCountText" Text="0" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 2: Çevrimiçi Cihaz -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="4,0,4,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#ECFDF5" CornerRadius="8" Margin="0,0,12,0">
                                <Ellipse Width="11" Height="11" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ÇEVRİMİÇİ CİHAZLAR" Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OnlineCountText" Text="0" Foreground="#047857" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 3: Çevrimdışı Cihaz -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="4,0,4,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#F8FAFC" CornerRadius="8" Margin="0,0,12,0">
                                <Ellipse Width="11" Height="11" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ÇEVRİMDIŞI CİHAZLAR" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OfflineCountText" Text="0" Foreground="#334155" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 4: Servis & Bulut Durumu -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="8,0,0,0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="36" Height="36" Background="#F1F5F9" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SİNYALLEŞME" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Hub aktif" Foreground="#2563EB" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ROW 1: Header, Search & Action Bar -->
                <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CheckUpdatesBtn" Style="{StaticResource ToolBtn}" Content="Güncellemeyi kontrol et" Click="CheckUpdatesBtn_Click" ToolTip="Sunucudan en son Teknisyen Konsolu güncellemesini kontrol eder ve yükler" Padding="12,7" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ToolBtn}" Content="Yenile" Click="RefreshDevices_Click" Padding="12,7" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerBtn}" Content="Çıkış yap" Click="LogoutBtn_Click" Padding="12,7" />
                    </StackPanel>

                    <!-- Search Input Box -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,0" Width="380" HorizontalAlignment="Left" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12.5" Foreground="#0F172A" TextChanged="SearchBox_TextChanged" ToolTip="Cihaz adı, IP, kullanıcı, lokasyon veya işletim sistemi ara"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FilterSummaryText" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" Text="Tüm cihazlar gösteriliyor."/>
                </DockPanel>

                <!-- ROW 2: Devices DataGrid (white card, soft border, matches web console tables) -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="6">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="16" ShadowDepth="2" Direction="270" />
                    </Border.Effect>
                    <DataGrid x:Name="DevicesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8FAFC"
                              Foreground="#0F172A"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="0"
                              SelectionMode="Single"
                              RowHeight="44"
                              MouseDoubleClick="DevicesDataGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Durum Rozeti -->
                            <DataGridTemplateColumn Header="DURUM" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeBg}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusDotBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeFg}" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cihaz Adı & Sistem -->
                            <DataGridTemplateColumn Header="CİHAZ VE İŞLETİM SİSTEMİ" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding OperatingSystem}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Aktif Kullanıcı -->
                            <DataGridTemplateColumn Header="AKTİF KULLANICI" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" FontSize="11" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding ActiveUser}" Foreground="#334155" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- IP Adresi -->
                            <DataGridTemplateColumn Header="IP ADRESİ" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="11.5" Foreground="#0F172A"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Lokasyon -->
                            <DataGridTextColumn Header="LOKASYON" Binding="{Binding LocationCode}" Width="100" />

                            <DataGridTemplateColumn Header="CPU / RAM" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding CpuText}" Foreground="#0F172A" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding MemoryUsageText}" Foreground="#64748B" FontSize="11.5"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding CpuUsagePercent}" Maximum="100" Height="4" Margin="0,4,0,0" Background="#E2E8F0" Foreground="#2563EB"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="AJAN" Binding="{Binding AgentVersionLabel}" Width="90" />
                            <DataGridTextColumn Header="SON SİNYAL" Binding="{Binding LastSeenLabel}" Width="120" />

                            <!-- İşlem Butonu -->
                            <DataGridTemplateColumn Header="İŞLEM" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Bağlan"
                                                Style="{StaticResource PrimaryBtn}"
                                                Padding="14,5"
                                                FontSize="12"
                                                Click="ConnectToDevice_Click"
                                                Tag="{Binding Id}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- VIEW 2: Remote Desktop Canvas — maximum viewport coverage matching Image 2 -->
            <Grid x:Name="RemoteCanvasGrid" Visibility="Collapsed" Background="#000000">
                <ScrollViewer x:Name="RemoteScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="True"
                              SnapsToDevicePixels="True"
                              RenderOptions.BitmapScalingMode="HighQuality"
                              RenderOptions.EdgeMode="Aliased">
                    <WrapPanel x:Name="MultiScreenPanel"
                               Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Aliased"
                               Margin="0" />
                </ScrollViewer>

                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="#E60F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="28,24" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Width="360">
                            <TextBlock x:Name="PlaceholderIcon" Text="🔄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock x:Name="PlaceholderTitle" Text="Görüntü Akışı Bekleniyor" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" TextAlignment="Center"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="Uzak cihaz açıldığında canlı yayın otomatik olarak bağlanacaktır."
                                       Foreground="#94A3B8"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <Button x:Name="PlaceholderRetryBtn" Content="⚡ Şimdi Yeniden Bağlan" Style="{StaticResource PrimaryBtn}" Height="34" FontSize="12" Click="RefreshScreenBtn_Click" HorizontalAlignment="Center" Padding="16,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top-Left Device Info & Telemetry Badge -->
                <Border x:Name="SessionDeviceBadge"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Background="#E60F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="14,12,0,0"
                        Padding="10,6"
                        Panel.ZIndex="99">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#94A3B8" Margin="0,0,6,0"/>
                        <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SessionDeviceNameText" Text="Uzak Oturum" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" · " Foreground="#64748B" Margin="2,0"/>
                        <TextBlock x:Name="SessionStatsText" Text="Canlı Oturum" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Floating Island Top Toolbar (Audit Standard) -->
                <Grid x:Name="FloatingIslandContainer"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Center"
                      Margin="0,12,0,0"
                      Panel.ZIndex="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main Floating Pill -->
                    <Border x:Name="FloatingIslandPill"
                            Grid.Row="0"
                            Background="#E60F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6,4">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="18" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Displays Switcher -->
                            <Button x:Name="IslandDisplaysBtn" Style="{StaticResource IslandBtn}" Content="Ekranlar" ToolTip="Monitör seçimi (soldan sağa sıralı)" Click="IslandDisplaysBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="IslandDisplaysContextMenu"/>
                                </Button.ContextMenu>
                            </Button>

                            <!-- View Mode -->
                            <Button x:Name="IslandViewModeBtn" Style="{StaticResource IslandBtn}" Content="Görünüm" ToolTip="Görünüm modu (sığdır / yay / 1:1)" Click="ViewModeBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ekrana sığdır (orantılı)" Click="ViewModeFit_Click" />
                                        <MenuItem Header="Ekrana yay (tam doldur)" Click="ViewModeStretch_Click" />
                                        <MenuItem Header="Orijinal boyut (1:1 piksel)" Click="ViewModeOriginal_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Adaptive Quality Profile Switcher -->
                            <Button x:Name="IslandQualityBtn" Style="{StaticResource IslandBtn}" Content="⚡ Kalite" ToolTip="Bağlantı ve görüntü kalitesi profili" Click="IslandQualityBtn_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="IslandQualityContextMenu">
                                        <MenuItem x:Name="QualityAutoItem" Header="⚡ Otomatik (Ağ Uyumlu - Önerilen)" IsChecked="True" Click="QualityAuto_Click" />
                                        <Separator />
                                        <MenuItem x:Name="QualitySpeedItem" Header="🚀 Hız &amp; Sıfır Gecikme Öncelikli" Click="QualitySpeed_Click" />
                                        <MenuItem x:Name="QualityBalancedItem" Header="⚖️ Dengeli Standart (40 FPS)" Click="QualityBalanced_Click" />
                                        <MenuItem x:Name="QualityCrystalItem" Header="💎 Kristal Netlik (Maksimum Kalite)" Click="QualityCrystal_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>


                            <!-- Screen Refresh -->
                            <Button x:Name="IslandRefreshBtn" Style="{StaticResource IslandBtn}" Content="Yenile" ToolTip="Uzak ekranı yenile" Click="RefreshScreenBtn_Click"/>

                            <!-- Disconnect Session (Red Pill) -->
                            <Button x:Name="IslandDisconnectBtn" Style="{StaticResource IslandDangerBtn}" Content="Sonlandır" ToolTip="Bağlantıyı sonlandır" Click="DisconnectBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Handle Tab -->
                    <Border x:Name="IslandCollapseHandle"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Background="#E60F172A"
                            BorderBrush="#334155"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8"
                            Padding="12,2"
                            Margin="0,-1,0,0"
                            Cursor="Hand"
                            MouseLeftButtonDown="IslandCollapseHandle_MouseLeftButtonDown">
                        <TextBlock x:Name="IslandCollapseIcon" Text="::: ⌃" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- Remote Command Panel Drawer -->
                <Border x:Name="CommandPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Bottom"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Padding="16,12"
                        Height="230"
                        Panel.ZIndex="101">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolBtn}" Content="Kapat" Click="CommandPanelToggleBtn_Click" Padding="10,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Uzak komut çalıştır" Foreground="#0F172A" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button x:Name="ShellCmdBtn" Style="{StaticResource ShellTabBtn}" Content="CMD" Background="#2563EB" Foreground="White" Click="ShellCmdBtn_Click" />
                                <Button x:Name="ShellPsBtn" Style="{StaticResource ShellTabBtn}" Content="PowerShell" Click="ShellPsBtn_Click" />
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="16,0,0,0"
                                        ToolTip="Komutlar hedef bilgisayarda her zaman tam Yönetici / SYSTEM yetkisiyle yürütülür.">
                                    <TextBlock Text="🛡️ Yönetici Yetkili (SYSTEM)" Foreground="#065F46" FontWeight="SemiBold" FontSize="11.5" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <TextBox x:Name="CommandOutputBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 Background="#0F172A"
                                 Foreground="#E2E8F0"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8" />

                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="Çalıştır" Click="RunCommandBtn_Click" Padding="14,6" />
                            <TextBox x:Name="CommandInputBox"
                                     Background="#F8FAFC"
                                     Foreground="#0F172A"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center"
                                     KeyDown="CommandInputBox_KeyDown" />
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Bottom Status & Metrics Bar -->
        <Border x:Name="BottomStatusBorder" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LatencyText" Foreground="#0EA5E9" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" Text="Ping: -- ms" />
                    <TextBlock x:Name="ThroughputText" Foreground="#D97706" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" Text="Bant: 0 KB/s" />
                    <TextBlock x:Name="FpsText" Foreground="#059669" FontSize="11" FontWeight="Bold" Text="FPS: 0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Text="Hazır" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
