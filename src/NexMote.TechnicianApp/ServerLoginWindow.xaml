<Window x:Class="NexMote.TechnicianApp.ServerLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMote - Teknisyen Girişi" Height="460" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="24" ShadowDepth="4" Direction="270" />
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Branding -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0">
                    <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NexMote" Foreground="#0F172A" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Teknisyen oturumu ve sunucu bağlantısı" Foreground="#64748B" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,0,0,20" />

            <!-- Server address field -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Sunucu adresi" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox x:Name="ServerUrlBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
            </StackPanel>

            <!-- Email Field -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="E-posta adresi" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox x:Name="EmailBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
            </StackPanel>

            <!-- Password Field -->
            <StackPanel Grid.Row="4" Margin="0,0,0,10">
                <TextBlock Text="Parola" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox x:Name="PasswordBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
            </StackPanel>

            <!-- Remember Me Checkbox -->
            <DockPanel Grid.Row="5" LastChildFill="True" Margin="0,4,0,0">
                <CheckBox x:Name="RememberMeCheckBox" Content="Bu cihazda hatırla" Foreground="#64748B" FontSize="12" IsChecked="True" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Error Banner -->
            <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,0" />

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="İptal" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" Background="#F1F5F9" Foreground="#334155" BorderThickness="1" BorderBrush="#E2E8F0" FontSize="13" FontWeight="SemiBold" />
                <Button Content="Giriş yap" Width="120" Height="36" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
