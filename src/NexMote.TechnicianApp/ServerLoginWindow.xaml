<Window x:Class="NexMote.TechnicianApp.ServerLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMote - Teknisyen Girişi" Height="480" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="24" ShadowDepth="4" Direction="270" />
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Branding -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0">
                    <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NexMote" Foreground="#0F172A" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="SubtitleText" Text="Teknisyen oturumu ve sunucu bağlantısı" Foreground="#64748B" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,0,0,20" />

            <!-- Step 1: Credentials -->
            <StackPanel x:Name="CredentialsPanel" Grid.Row="2">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Sunucu adresi" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="ServerUrlBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="E-posta adresi" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="EmailBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Parola" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <PasswordBox x:Name="PasswordBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
                </StackPanel>

                <DockPanel LastChildFill="True" Margin="0,4,0,0">
                    <CheckBox x:Name="RememberMeCheckBox" Content="Bu cihazda hatırla" Foreground="#64748B" FontSize="12" IsChecked="True" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>

            <!-- Step 2: MFA code (gizli, sadece sunucu MFA istediğinde görünür) -->
            <StackPanel x:Name="MfaPanel" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="Authenticator uygulamanızdaki 6 haneli kodu (veya bir kurtarma kodunu) girin." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Doğrulama kodu" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="MfaCodeBox" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" FontSize="13" />
                </StackPanel>
                <Button x:Name="BackToCredentialsButton" Content="Geri dön" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontSize="12" Click="BackToCredentials_Click" Cursor="Hand" />
            </StackPanel>

            <!-- Error Banner -->
            <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,0" />

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="İptal" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" Background="#F1F5F9" Foreground="#334155" BorderThickness="1" BorderBrush="#E2E8F0" FontSize="13" FontWeight="SemiBold" />
                <Button x:Name="PrimaryButton" Content="Giriş yap" Width="150" Height="36" Click="Primary_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
