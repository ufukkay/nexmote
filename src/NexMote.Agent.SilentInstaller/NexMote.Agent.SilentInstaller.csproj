<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexMote.Agent.SilentInstaller</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Bu proje bilerek NexMote.sln'e eklenmedi ve normal dotnet build/publish akislarinda
         derlenmez - sadece scripts\build-silent-installer.ps1 uzerinden, gomulecek admin
         kimlik bilgisi script parametresi olarak verildiginde derlenir. Credentials.Generated.cs
         o script tarafindan derlemeden hemen once uretilir ve hemen sonra silinir; asla git'e
         eklenmez (bkz. .gitignore). -->
  </PropertyGroup>
</Project>
