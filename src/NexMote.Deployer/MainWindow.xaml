<Window x:Class="NexMote.Deployer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NexMote - Uzaktan Ajan Dağıtım &amp; Yükleme Aracı (Deployer)"
        Height="820" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Glassmorphism Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Modern Button Styles -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top App Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Inputs + Dashboard) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Action Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NexMote" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Uzaktan Ajan Dağıtım Aracı" FontSize="18" FontWeight="SemiBold" Foreground="#94A3B8" Margin="8,0,0,0"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.7.2" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Yerel ağdaki bilgisayarlara uzaktan kimlik bilgileriyle sessizce NexMote Ajanı kurar." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshMsiBtn" Style="{StaticResource SecondaryBtn}" Content="☁️ Güncel Paketi İndir" Click="RefreshMsiBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="SelectLocalMsiBtn" Style="{StaticResource SecondaryBtn}" Content="📁 Yerel MSI Seç..." Click="SelectLocalMsiBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- 2. Main Content Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Configuration Panel -->
                <ColumnDefinition Width="380"/>
                <!-- Right Live Dashboard & DataGrid -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Form Card -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Target IP Specification -->
                        <TextBlock Text="🎯 Hedef Cihazlar / IP Bilgisi" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <TextBlock Text="Tek IP (192.168.0.126), Aralık (192.168.0.10-50) veya CIDR (192.168.0.0/24)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBox x:Name="TargetIpsBox" Style="{StaticResource ModernTextBox}" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="192.168.0.126&#x0a;192.168.0.10-20" Margin="0,0,0,16"/>

                        <!-- Admin Credentials -->
                        <TextBlock Text="🔐 Yönetici Kimlik Bilgileri" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <TextBlock Text="Hedef makinede yönetici yetkisine sahip hesap." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>

                        <TextBlock Text="Kullanıcı Adı (Örn: .\ITDestek, DOMAIN\admin):" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}" Text=".\ITDestek" Margin="0,0,0,10"/>

                        <TextBlock Text="Şifre:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16"/>

                        <!-- Server Parameters -->
                        <TextBlock Text="🌐 Sunucu &amp; Kayıt Parametreleri" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        
                        <TextBlock Text="Sunucu URL:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Style="{StaticResource ModernTextBox}" Text="https://nexmote.com" Margin="0,0,0,10"/>

                        <TextBlock Text="Kayıt Anahtarı (EnrollmentKey):" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnrollmentKeyBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                        <!-- Advanced Options -->
                        <TextBlock Text="⚙️ Seçenekler" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <CheckBox x:Name="BypassLocalTokenFilterCheck" IsChecked="True" Content="Uzak UAC İznini Aç (LocalAccountTokenFilterPolicy)" Foreground="#CBD5E1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="PingCheckFirstCheck" IsChecked="True" Content="Kurulumdan önce Ping / Port 445 kontrolü yap" Foreground="#CBD5E1" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <Button x:Name="StartDeployBtn" Style="{StaticResource PrimaryBtn}" Content="🚀 Dağıtımı Başlat (Toplu Kurulum)" Click="StartDeployBtn_Click" Margin="0,0,0,8"/>
                        <Button x:Name="StopDeployBtn" Style="{StaticResource DangerBtn}" Content="⏹️ İşlemi Durdur" Click="StopDeployBtn_Click" IsEnabled="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Results Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Metric Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Progress Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Metric Cards Row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Card -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Toplam Hedef" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TotalCountTxt" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Success Card -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Başarılı" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="SuccessCountTxt" Text="0" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Failed Card -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Hatalı" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="FailedCountTxt" Text="0" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Running / Pending Card -->
                    <Border Grid.Column="3" Style="{StaticResource GlassCard}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="İşleniyor / Kuyrukta" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="PendingCountTxt" Text="0" FontSize="20" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <ProgressBar x:Name="DeployProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1E293B" Foreground="#2563EB" BorderThickness="0"/>
                </Grid>

                <!-- Live Results DataGrid -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0">
                    <DataGrid x:Name="TargetsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#1E293B"
                              AlternatingRowBackground="#182234"
                              Foreground="#F8FAFC"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column"
                              RowHeight="38">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- IP -->
                            <DataGridTextColumn Header="IP Adresi" Binding="{Binding Ip}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hostname -->
                            <DataGridTextColumn Header="Bilgisayar Adı" Binding="{Binding Hostname}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ping -->
                            <DataGridTextColumn Header="Ping" Binding="{Binding PingDisplay}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Durum" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Details / Error -->
                            <DataGridTextColumn Header="Detay / Hata Mesajı" Binding="{Binding Details}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Duration -->
                            <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. Bottom Action Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusSummaryTxt" Text="Hazır. Dağıtımı başlatmak için IP bilgilerini girip 'Dağıtımı Başlat' butonuna basın." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RetryFailedBtn" Style="{StaticResource SecondaryBtn}" Content="🔄 Hatalıları Yeniden Dene" Click="RetryFailedBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ExportCsvBtn" Style="{StaticResource SecondaryBtn}" Content="📥 CSV Dışa Aktar" Click="ExportCsvBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="ClearListBtn" Style="{StaticResource SecondaryBtn}" Content="🧹 Temizle" Click="ClearListBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
