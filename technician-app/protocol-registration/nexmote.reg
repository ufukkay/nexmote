Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\nexmote]
@="URL:NexMote Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\nexmote\DefaultIcon]
@="C:\\Program Files\\NexMote\\Technician\\NexMote.TechnicianApp.exe,1"

[HKEY_CLASSES_ROOT\nexmote\shell\open\command]
@="\"C:\\Program Files\\NexMote\\Technician\\NexMote.TechnicianApp.exe\" \"%1\""

