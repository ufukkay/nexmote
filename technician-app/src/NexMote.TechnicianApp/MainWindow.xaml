<Window x:Class="NexMote.TechnicianApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMote Technician" Height="520" Width="860"
        MinHeight="420" MinWidth="720">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14212F" Padding="22,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="NexMote Technician App"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,16">
                <TextBlock Text="Baglanti Oturumu" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SessionText"
                           Margin="0,6,0,0"
                           Foreground="#526174"
                           Text="Web panelden nexmote:// linki ile acildiginda session bilgisi burada gorunecek." />
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="RemoteSurface"
                      ClipToBounds="True"
                      Background="Transparent"
                      Focusable="True"
                      MouseMove="RemoteSurface_MouseMove"
                      MouseLeftButtonDown="RemoteSurface_MouseLeftButtonDown"
                      MouseLeftButtonUp="RemoteSurface_MouseLeftButtonUp"
                      MouseRightButtonDown="RemoteSurface_MouseRightButtonDown"
                      MouseRightButtonUp="RemoteSurface_MouseRightButtonUp"
                      MouseDown="RemoteSurface_MouseDown"
                      MouseUp="RemoteSurface_MouseUp"
                      MouseWheel="RemoteSurface_MouseWheel"
                      KeyDown="RemoteSurface_KeyDown"
                      KeyUp="RemoteSurface_KeyUp">
                    <Image x:Name="RemoteImage"
                           Stretch="Uniform"
                           IsHitTestVisible="False"
                           SnapsToDevicePixels="True" />
                    <TextBlock x:Name="PlaceholderText"
                               Text="Goruntu bekleniyor."
                               Foreground="#66758A"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="22,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#526174" Text="Hazir" />
        </Border>
    </Grid>
</Window>
