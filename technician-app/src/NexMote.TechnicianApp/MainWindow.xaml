<Window x:Class="NexMote.TechnicianApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexMote Technician Console - Uzaktan Destek İstemcisi" Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DisplayBtn" TargetType="Button">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#090D16">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- Top AnyDesk-Style Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel LastChildFill="True">
                <!-- Right Action Buttons -->
                <StackPanel x:Name="RemoteControlsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="ClipboardBtn" Style="{StaticResource ToolBtn}" Content="📋 Pano Gönder" Click="ClipboardBtn_Click" ToolTip="Yerel panodaki metni uzak cihaza aktarır" />
                    <Button x:Name="QualityToggleBtn" Style="{StaticResource ToolBtn}" Content="⚡ Kalite: Dengeli" Click="QualityToggleBtn_Click" />
                    <Button x:Name="StretchToggleBtn" Style="{StaticResource ToolBtn}" Content="📐 Ölçek: Sığdır" Click="StretchToggleBtn_Click" />
                    <Button x:Name="WinDBtn" Style="{StaticResource ToolBtn}" Content="Win+D" Click="WinDBtn_Click" ToolTip="Masaüstünü Göster" />
                    <Button x:Name="AltTabBtn" Style="{StaticResource ToolBtn}" Content="Alt+Tab" Click="AltTabBtn_Click" ToolTip="Pencereler Arası Geçiş" />
                    <Button x:Name="CtrlAltDelBtn" Style="{StaticResource ToolBtn}" Content="Ctrl+Alt+Del" Click="CtrlAltDelBtn_Click" />
                    <Button x:Name="ShowDevicesBtn" Style="{StaticResource ToolBtn}" Content="🖥️ Cihaz Listesi" Click="ShowDevicesBtn_Click" />
                    <Button x:Name="DisconnectBtn" Style="{StaticResource ToolBtn}" Background="#DC2626" BorderBrush="#EF4444" Content="🔴 Sonlandır" Click="DisconnectBtn_Click" />
                </StackPanel>

                <!-- Left Branding & Navigation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB" Margin="0,0,12,0">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="NexMote AnyControl" Foreground="White" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="SessionText" Foreground="#64748B" FontSize="11" Text="Oturum bekleniyor..." />
                    </StackPanel>

                    <!-- Multi-Monitor Buttons Container (Only during session) -->
                    <Border x:Name="MonitorSelectorBorder" Background="#020617" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,2" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️ Monitör:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,6,0" />
                            <StackPanel x:Name="DisplayStackPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DisplayBtn}" Content="Tüm Ekranlar" Background="#2563EB" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area (Device Inventory or Remote Canvas) -->
        <Grid Grid.Row="1" Background="#030712">
            
            <!-- VIEW 1: Device Inventory Screen (Shown by default when app opens) -->
            <Grid x:Name="DeviceInventoryGrid" Visibility="Visible" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header & Search Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolBtn}" Content="🔄 Listeyi Yenile" Click="RefreshDevices_Click" Padding="12,6" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Kayıtlı Cihaz Envanteri" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Doğrudan bağlantı kurmak istediğiniz online cihaza tıklayın." Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Devices DataGrid -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="8">
                    <DataGrid x:Name="DevicesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#0F172A"
                              AlternatingRowBackground="#1E293B"
                              Foreground="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              BorderThickness="0"
                              SelectionMode="Single"
                              MouseDoubleClick="DevicesDataGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText}" Width="100" />
                            <DataGridTextColumn Header="CİHAZ ADI" Binding="{Binding DeviceName}" Width="180" />
                            <DataGridTextColumn Header="İŞLETİM SİSTEMİ" Binding="{Binding OperatingSystem}" Width="160" />
                            <DataGridTextColumn Header="AKTİF KULLANICI" Binding="{Binding ActiveUser}" Width="220" />
                            <DataGridTextColumn Header="IP ADRESİ" Binding="{Binding IpAddress}" Width="140" />
                            <DataGridTextColumn Header="LOKASYON" Binding="{Binding LocationCode}" Width="110" />
                            <DataGridTemplateColumn Header="İŞLEM" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚡ Bağlan"
                                                Style="{StaticResource ToolBtn}"
                                                Background="#2563EB"
                                                Foreground="White"
                                                Padding="12,4"
                                                Click="ConnectToDevice_Click"
                                                Tag="{Binding Id}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- VIEW 2: Remote Desktop Canvas (Shown during active session) -->
            <Grid x:Name="RemoteCanvasGrid" Visibility="Collapsed">
                <ScrollViewer x:Name="RemoteScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="RemoteSurface"
                          ClipToBounds="True"
                          Background="Transparent"
                          Focusable="True"
                          MouseMove="RemoteSurface_MouseMove"
                          MouseLeftButtonDown="RemoteSurface_MouseLeftButtonDown"
                          MouseLeftButtonUp="RemoteSurface_MouseLeftButtonUp"
                          MouseRightButtonDown="RemoteSurface_MouseRightButtonDown"
                          MouseRightButtonUp="RemoteSurface_MouseRightButtonUp"
                          MouseDown="RemoteSurface_MouseDown"
                          MouseUp="RemoteSurface_MouseUp"
                          MouseWheel="RemoteSurface_MouseWheel"
                          KeyDown="RemoteSurface_KeyDown"
                          KeyUp="RemoteSurface_KeyUp">

                        <Image x:Name="RemoteImage"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               SnapsToDevicePixels="True" />

                        <StackPanel x:Name="PlaceholderPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="🖥️" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="Uzaktan yüksek hızlı görüntü akışı bekleniyor..."
                                       Foreground="#94A3B8"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Bottom AnyDesk Status & Metrics Bar -->
        <Border Grid.Row="2" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LatencyText" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" Text="Ping: -- ms" />
                    <TextBlock x:Name="ThroughputText" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" Text="Bant: 0 KB/s" />
                    <TextBlock x:Name="FpsText" Foreground="#10B981" FontSize="11" FontWeight="Bold" Text="FPS: 0 | 0x0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Text="Hazır" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
